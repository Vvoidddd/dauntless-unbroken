{
  "name": "Dauntless Unbroken",
  "description": "Purple aether palette for Dauntless Unbroken. Shared tokens are checked against WCAG contrast requirements.",
  "colors": {
    "ink": {
      "hex": "#0D0914",
      "rgb": [
        13,
        9,
        20
      ],
      "role": "Page background"
    },
    "navy": {
      "hex": "#181020",
      "rgb": [
        24,
        16,
        32
      ],
      "role": "Surface: sidebar, cards, code blocks, header"
    },
    "deep": {
      "hex": "#2B1B3D",
      "rgb": [
        43,
        27,
        61
      ],
      "role": "Raised surface and borders between surfaces (decorative, not a control boundary)"
    },
    "azure": {
      "hex": "#7954B8",
      "rgb": [
        121,
        84,
        184
      ],
      "role": "Dark accent: hover and pressed fills, control borders on ink"
    },
    "ice": {
      "hex": "#B990FF",
      "rgb": [
        185,
        144,
        255
      ],
      "role": "Primary accent: links, primary buttons"
    },
    "glow": {
      "hex": "#E6CEFF",
      "rgb": [
        230,
        206,
        255
      ],
      "role": "Highlights, hovered links, focus rings, small glows"
    },
    "steel": {
      "hex": "#B7ABC7",
      "rgb": [
        183,
        171,
        199
      ],
      "role": "Muted text: captions, metadata, footers"
    },
    "frost": {
      "hex": "#FAF6FF",
      "rgb": [
        250,
        246,
        255
      ],
      "role": "Body text and headings"
    }
  },
  "contrast": {
    "method": "WCAG 2.2 relative luminance. AA needs 4.5:1 for normal text, 3:1 for large text (24px, or 18.66px bold) and for UI components and focus indicators.",
    "pairs": [
      {
        "fg": "frost",
        "bg": "ink",
        "kind": "text",
        "use": "Body text on the page",
        "ratio": 18.47
      },
      {
        "fg": "frost",
        "bg": "navy",
        "kind": "text",
        "use": "Body text on surfaces",
        "ratio": 17.37
      },
      {
        "fg": "frost",
        "bg": "deep",
        "kind": "text",
        "use": "Text on raised surfaces, selected nav item",
        "ratio": 14.84
      },
      {
        "fg": "steel",
        "bg": "ink",
        "kind": "text",
        "use": "Muted text on the page",
        "ratio": 9.06
      },
      {
        "fg": "steel",
        "bg": "navy",
        "kind": "text",
        "use": "Muted text on surfaces",
        "ratio": 8.52
      },
      {
        "fg": "steel",
        "bg": "deep",
        "kind": "text",
        "use": "Muted text on raised surfaces",
        "ratio": 7.28
      },
      {
        "fg": "ice",
        "bg": "ink",
        "kind": "text",
        "use": "Links on the page",
        "ratio": 7.97
      },
      {
        "fg": "ice",
        "bg": "navy",
        "kind": "text",
        "use": "Links on surfaces",
        "ratio": 7.49
      },
      {
        "fg": "ice",
        "bg": "deep",
        "kind": "text",
        "use": "Links on raised surfaces",
        "ratio": 6.4
      },
      {
        "fg": "glow",
        "bg": "ink",
        "kind": "text",
        "use": "Hovered links and highlights on the page",
        "ratio": 13.73
      },
      {
        "fg": "glow",
        "bg": "navy",
        "kind": "text",
        "use": "Hovered links and highlights on surfaces",
        "ratio": 12.91
      },
      {
        "fg": "glow",
        "bg": "deep",
        "kind": "text",
        "use": "Hovered links on raised surfaces",
        "ratio": 11.03
      },
      {
        "fg": "ink",
        "bg": "ice",
        "kind": "text",
        "use": "Primary button label",
        "ratio": 7.97
      },
      {
        "fg": "ink",
        "bg": "glow",
        "kind": "text",
        "use": "Primary button label on hover",
        "ratio": 13.73
      },
      {
        "fg": "frost",
        "bg": "azure",
        "kind": "text",
        "use": "Label on an azure (pressed or secondary) fill",
        "ratio": 5.22
      },
      {
        "fg": "glow",
        "bg": "ink",
        "kind": "ui",
        "use": "Focus ring on the page",
        "ratio": 13.73
      },
      {
        "fg": "glow",
        "bg": "navy",
        "kind": "ui",
        "use": "Focus ring on surfaces",
        "ratio": 12.91
      },
      {
        "fg": "ice",
        "bg": "ink",
        "kind": "ui",
        "use": "Primary button edge against the page",
        "ratio": 7.97
      },
      {
        "fg": "azure",
        "bg": "ink",
        "kind": "ui",
        "use": "Input and control borders on the page",
        "ratio": 3.54
      },
      {
        "fg": "steel",
        "bg": "navy",
        "kind": "ui",
        "use": "Input and control borders on surfaces",
        "ratio": 8.52
      }
    ],
    "avoid": [
      {
        "fg": "#FFFFFF",
        "bg": "ice",
        "ratio": 2.47,
        "why": "White text on the primary accent fails AA; use ink on ice"
      },
      {
        "fg": "frost",
        "bg": "ice",
        "ratio": 2.32,
        "why": "Same for frost"
      },
      {
        "fg": "azure",
        "bg": "ink",
        "ratio": 3.54,
        "why": "Azure is too dark for normal-size text; only large text or UI borders"
      },
      {
        "fg": "azure",
        "bg": "navy",
        "ratio": 3.33,
        "why": "Fails 3:1 even for control borders; use steel on navy"
      },
      {
        "fg": "deep",
        "bg": "ink",
        "ratio": 1.24,
        "why": "Decorative dividers only, never the only edge of a control"
      },
      {
        "fg": "ice",
        "bg": "azure",
        "ratio": 2.25,
        "why": "Accent on accent is unreadable"
      },
      {
        "fg": "steel",
        "bg": "azure",
        "ratio": 2.56,
        "why": "Muted text on an azure fill fails; use frost"
      }
    ]
  }
}
