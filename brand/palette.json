      },
      {
        "fg": "frost",
        "bg": "ice",
        "ratio": 2.35,
        "why": "Same for frost"
      },
      {
        "fg": "azure",
        "bg": "ink",
        "ratio": 3.39,
        "why": "Azure is too dark for normal-size text; only large text or UI borders"
      },
      {
        "fg": "azure",
        "bg": "navy",
        "ratio": 3.11,
        "why": "Fails 3:1 even for control borders; use steel on navy"
      },
      {
        "fg": "deep",
        "bg": "ink",
        "ratio": 1.35,
        "why": "Decorative dividers only, never the only edge of a control"
      },
      {
        "fg": "ice",
        "bg": "azure",
        "ratio": 2.25,
        "why": "Accent on accent is unreadable"
