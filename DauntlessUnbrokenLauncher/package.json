{
  "name": "dauntless-unbroken-launcher",
  "productName": "Dauntless Unbroken Launcher",
  "version": "1.0.38",
  "description": "Cross-platform launcher for Dauntless Unbroken: join community servers, download and verify the pinned Dauntless 1.4.4 client, and play on Windows or Linux via Proton/Wine.",
  "main": ".vite/build/main.js",
  "private": true,
  "homepage": "https://github.com/Vvoidddd/dauntless-unbroken",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vvoidddd/dauntless-unbroken.git",
    "directory": "DauntlessUnbrokenLauncher"
  },
  "bugs": {
    "url": "https://github.com/Vvoidddd/dauntless-unbroken/issues"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package --platform win32",
    "make": "electron-forge make --platform win32",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/run-tests.mjs",
    "stage:offline": "node scripts/stage-offline-runtime.mjs",
    "icon": "node scripts/make-icon.mjs",
    "package:linux": "electron-forge package --platform linux --arch x64",
    "make:linux": "electron-forge make --platform linux --arch x64",
    "collect:linux": "node scripts/collect-linux-release.mjs"
  },
  "keywords": [
    "dauntless",
    "launcher",
    "private-server"
  ],
  "author": {
    "name": "Vvoidddd",
    "url": "https://github.com/Vvoidddd"
  },
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.17",
    "npm": ">=11.19"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^2.1.3",
    "@electron/rebuild": "^3.7.2",
    "@reforged/maker-appimage": "^5.3.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^24.0.0",
    "@types/node-forge": "^1.3.14",
    "electron": "44.7.0",
    "node-forge": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "update-electron-app": "^3.3.0"
  },
  "overrides": {
    "extract-zip": "npm:@electron-internal/extract-zip@^1.0.1",
    "tar": "^7.5.22",
    "tmp": "^0.2.7"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true
  }
}
