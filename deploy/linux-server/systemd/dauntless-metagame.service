[Unit]
Description=Dauntless Unbroken metagame
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@ROOT@/DauntlessUnbrokenMetagame
ExecStart=@NODE@ --env-file=@CONFIG@/metagame.env @ROOT@/DauntlessUnbrokenMetagame/dist/server.js
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
